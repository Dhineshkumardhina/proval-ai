# PropVal AI — Environment Configuration Template
# NOTE: The core deterministic property valuation engine and underwriting interface
# run entirely locally and offline without requiring external API keys or cloud services.

# GEMINI_API_KEY: Optional starter placeholder for future Gemini API extensions.
# Not required for running the local valuation prototype.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Optional application URL placeholder.
APP_URL="http://localhost:3000"
