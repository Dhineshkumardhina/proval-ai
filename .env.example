# =============================================================================
# PropVal AI — Environment Configuration Template (.env.example)
# Institutional Automated Valuation & Credit Underwriting Platform
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to '.env' before starting the application:
#    cp .env.example .env
# 2. NEVER commit actual production secrets, passwords, or API keys to version control.
# 3. For production deployments, ensure all placeholders are replaced with strong,
#    unique cryptographic values.
# =============================================================================

# -----------------------------------------------------------------------------
# Runtime Environment & Architecture
# -----------------------------------------------------------------------------
# Options: 'development' | 'staging' | 'production'
# In 'production', debug mode is forced to false, SQLite is rejected, and strict
# startup configuration validation is enforced.
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="PropVal AI Institutional Valuation Backend"
VERSION=0.2.0

# -----------------------------------------------------------------------------
# Application URLs & Internal Host Bindings
# -----------------------------------------------------------------------------
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

# -----------------------------------------------------------------------------
# Relational Database Connection (PostgreSQL 16 + PostGIS)
# -----------------------------------------------------------------------------
# Format: postgresql://[DB_USER]:[DB_PASSWORD]@[DB_HOST]:[DB_PORT]/[DB_NAME]
# In production, use strong alphanumeric passwords (minimum 16 characters).
POSTGRES_USER=propval_user
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=propval_db
DATABASE_URL=postgresql://propval_user:your_strong_db_password_here@db:5432/propval_db

# PostgreSQL Connection Pool Parameters
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=300

# -----------------------------------------------------------------------------
# Cryptographic Security & Session Management (JWT / RBAC)
# -----------------------------------------------------------------------------
# Generate a cryptographically secure 256-bit hex secret using:
# python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=your_cryptographically_secure_random_jwt_secret_min_32_chars
SECRET_KEY=your_cryptographically_secure_random_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# -----------------------------------------------------------------------------
# Network Security & CORS Allowlist
# -----------------------------------------------------------------------------
# Comma-separated list of trusted origin URLs permitted to communicate with backend.
# NOTE: Wildcard '*' is strictly prohibited in production.
CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,https://propval.hero.internal
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,https://propval.hero.internal

# -----------------------------------------------------------------------------
# Rate Limiting & DoS Mitigation
# -----------------------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# -----------------------------------------------------------------------------
# Gemini AI Advisory Service (Google Generative AI)
# -----------------------------------------------------------------------------
# Optional API key for Google Gemini generative AI underwriter explanations.
# If omitted, the platform deterministically falls back to the offline rule-based engine.
# An unavailable external service will not be reported as healthy.
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_RATE_LIMIT_PER_MINUTE=15
ENABLE_AI_CLOUD_PROCESSING=true
AI_DISCLAIMER_TEXT="AI underwriter synthesis is advisory. All credit underwriting and collateral decisions require human review by a qualified institutional credit officer."

# -----------------------------------------------------------------------------
# File Ingestion Security Guardrails
# -----------------------------------------------------------------------------
# Maximum transaction dataset file upload size in bytes (25 MB = 26,214,400 bytes)
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls

# -----------------------------------------------------------------------------
# Valuation Engine Standards & Provenance
# -----------------------------------------------------------------------------
DEFAULT_DATA_SOURCE=institutional-verified
ENGINE_TYPE="provisional rule-based estimation"
ENGINE_VERSION=0.2.0
