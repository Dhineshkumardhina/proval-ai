# =============================================================================
# PropVal AI — Production Environment Configuration Template
# INSTRUCTIONS:
# 1. Copy this file to '.env.production' on the production host or orchestrator.
# 2. Generate strong, cryptographically unique secrets using 'openssl rand -hex 32'.
# 3. NEVER commit filled '.env.production' or active credentials to Git.
# 4. In production, 'validate_production_startup()' will abort execution if default
#    passwords, SQLite strings, or wildcard CORS entries are detected.
# =============================================================================

# --- Environment & Debug ---
ENVIRONMENT=production
DEBUG=false

# --- Server Bindings ---
HOST=0.0.0.0
PORT=8000
WORKERS=4

# --- Host URLs (Strict FQDNs with TLS/HTTPS) ---
FRONTEND_URL=https://propval.example.com
BACKEND_URL=https://api.propval.example.com

# --- Strict CORS Allowlist (No Wildcards Allowed in Production) ---
# Comma-separated list of fully-qualified authorized origins
BACKEND_CORS_ORIGINS=https://propval.example.com,https://admin.propval.example.com
CORS_ORIGINS=https://propval.example.com,https://admin.propval.example.com

# --- PostgreSQL 16 + PostGIS Relational Database ---
# Replace all placeholders with secure credentials
POSTGRES_USER=propval_prod_user
POSTGRES_PASSWORD=GENERATE_STRONG_RANDOM_PASSWORD_64_CHARS
POSTGRES_DB=propval_production
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Production SQLAlchemy Connection String (Must be PostgreSQL)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Database Connection Pooling (Engine Performance & Health) ---
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=300

# --- Authentication & JWT Cryptographic Signing ---
# Mandatory: Generate using 'openssl rand -hex 32' (>= 32 chars, cannot contain 'change-in-production')
SECRET_KEY=GENERATE_CRYPTO_RANDOM_SECRET_KEY_MIN_32_HEX_CHARS
JWT_SECRET=GENERATE_CRYPTO_RANDOM_SECRET_KEY_MIN_32_HEX_CHARS
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- AI Underwriter & Google Gemini Integration ---
# Optional: Leave empty to run strictly in offline deterministic rule-based mode
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_RATE_LIMIT_PER_MINUTE=15
ENABLE_AI_CLOUD_PROCESSING=false

# --- Ingestion & Upload Security Guardrails ---
MAX_UPLOAD_SIZE_BYTES=26214400

# --- Rate Limiting & DoS Protection ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20
