# =============================================================================
# PropVal AI — Institutional Production Environment Template (.env)
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env before deploying to production:
#    cp .env.production.example .env
# 2. Never commit actual secrets or production passwords into version control.
# 3. Rotate SECRET_KEY and database passwords periodically.
# =============================================================================

# --- Core Runtime Configuration ---
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="PropVal AI Institutional Valuation Backend"
VERSION=0.2.0
HOST=0.0.0.0
PORT=8000

# --- Cryptographic Security & Session Management ---
# CRITICAL: Generate a cryptographically secure 256-bit key using:
# python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-token-min-32-chars-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- Relational Database & Connection Pooling ---
# Production PostgreSQL URI: postgresql://[user]:[password]@[host]:[port]/[database]
POSTGRES_USER=propval_prod_user
POSTGRES_PASSWORD=replace-with-strong-db-password-16char-min
POSTGRES_DB=propval_production
DATABASE_URL=postgresql://propval_prod_user:replace-with-strong-db-password-16char-min@db:5432/propval_production

# SQLAlchemy Connection Pool Settings for High-Concurrency Production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=300

# --- Network & CORS Whitelisting ---
# Comma-separated list of fully qualified domains permitted to call the API
BACKEND_CORS_ORIGINS=https://propval.hero.internal,https://valuation.herohousing.in,http://localhost:3000

# --- Rate Limiting & DoS Mitigation ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

# --- File Ingestion Security Guardrails ---
# Maximum upload payload size in bytes (26,214,400 bytes = 25 MB)
MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls

# --- Gemini AI Underwriter Integration (Phase 2G) ---
# Advisory synthesis only. System operates in deterministic mock mode if key is empty.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_RATE_LIMIT_PER_MINUTE=15
ENABLE_AI_CLOUD_PROCESSING=true
AI_DISCLAIMER_TEXT="AI underwriter synthesis is advisory. All credit underwriting and collateral decisions require human review by a qualified institutional credit officer."

# --- Engine Standards & Provenance ---
DEFAULT_DATA_SOURCE=institutional-verified
ENGINE_TYPE="provisional rule-based estimation"
ENGINE_VERSION=0.2.0

