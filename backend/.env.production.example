# =============================================================================
# PropVal AI — Backend Production Environment Template
# =============================================================================
# See root .env.production.example for complete documentation.

ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="PropVal AI Institutional Valuation Backend"
VERSION=0.2.0
HOST=0.0.0.0
PORT=8000

SECRET_KEY=replace-with-a-cryptographically-secure-random-token-min-32-chars-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

DATABASE_URL=postgresql://propval_prod_user:replace-with-strong-db-password-16char-min@localhost:5432/propval_production
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=300

BACKEND_CORS_ORIGINS=https://propval.hero.internal,http://localhost:3000
RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_RATE_LIMIT_PER_MINUTE=15
ENABLE_AI_CLOUD_PROCESSING=true

