# =============================================================================
# PropVal AI — Backend Environment Configuration Template (.env.example)
# =============================================================================
ENVIRONMENT=production
DEBUG=false
PROJECT_NAME="PropVal AI Institutional Valuation Backend"
VERSION=0.2.0

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
HOST=0.0.0.0
PORT=8000

POSTGRES_USER=propval_user
POSTGRES_PASSWORD=your_strong_db_password_here
POSTGRES_DB=propval_db
DATABASE_URL=postgresql://propval_user:your_strong_db_password_here@db:5432/propval_db

DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE_SECONDS=300

JWT_SECRET=your_cryptographically_secure_random_jwt_secret_min_32_chars
SECRET_KEY=your_cryptographically_secure_random_jwt_secret_min_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,https://propval.hero.internal
BACKEND_CORS_ORIGINS=http://localhost,http://localhost:3000,http://127.0.0.1:3000,https://propval.hero.internal

RATE_LIMIT_ENABLED=true
RATE_LIMIT_GLOBAL_PER_MINUTE=120
RATE_LIMIT_AUTH_PER_MINUTE=20

GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_RATE_LIMIT_PER_MINUTE=15
ENABLE_AI_CLOUD_PROCESSING=true
AI_DISCLAIMER_TEXT="AI underwriter synthesis is advisory. All credit underwriting and collateral decisions require human review by a qualified institutional credit officer."

MAX_UPLOAD_SIZE_BYTES=26214400
ALLOWED_UPLOAD_EXTENSIONS=.csv,.xlsx,.xls

DEFAULT_DATA_SOURCE=institutional-verified
ENGINE_TYPE="provisional rule-based estimation"
ENGINE_VERSION=0.2.0
